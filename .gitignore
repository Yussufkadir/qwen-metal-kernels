cat > .gitignore << 'EOF'

# Python
venv/
__pycache__/
*.pyc
*.pyo

# Xcode
xcuserdata/
xcshareddata/
*.xcworkspace/
DerivedData/
build/

# Metal build artifacts
*.air

# Compiled binaries
libmetal_kernels.dylib

# Model weights (generated by export_weights.py)
qwen_weights/
*.bin

# System
.DS_Store
Thumbs.db
EOF