// inference.mm — Full Qwen 0.5B generation with custom Metal MLP kernels

#import <Foundation/Foundation.h>
#import <Metal/Metal.h>
#include <iostream>
#include <fstream>
#include <vector>
#include <cmath>
#include <cstring>
#include <algorithm>
#include <cstdint>

// Model dimensions
constexpr int NUM_LAYERS = 24;
constexpr int HIDDEN_DIM = 896;
constexpr int INTERMEDIATE = 4864;
constexpr int NUM_HEADS = 14;
constexpr int NUM_KV_HEADS = 2;
constexpr int HEAD_DIM = 64;
constexpr int VOCAB_SIZE = 151936;

// External functions from bridge.mm
extern "C" {
    int metal_init();
    int run_gate_up_batched(
        const uint16_t* gate_w, const uint16_t* up_w, const float* x,
        float* gate_out, float* up_out, uint32_t B, uint32_t M, uint32_t K);
    int run_down_batched(
        const uint16_t* down_w, const float* x, float* out,
        uint32_t B, uint32_t M, uint32_t K);
}

// ── Helpers ─────────────────────────────────────────────

id<MTLBuffer> loadHalfBuffer(id<MTLDevice> device, const std::string& path) {
    std::ifstream f(path, std::ios::binary | std::ios::ate);
    if (!f) { std::cerr << "Missing " << path << "\n"; exit(1); }
    size_t size = f.tellg();
    f.seekg(0);
    std::vector<uint16_t> data(size / 2);
    f.read((char*)data.data(), size);
    return [device newBufferWithBytes:data.data() length:size options:MTLResourceStorageModeShared];
}

void runKernel(id<MTLDevice> device, id<MTLCommandQueue> queue,
               id<MTLComputePipelineState> pipeline, NSArray* buffers, uint N) {
    id<MTLCommandBuffer> cmd = [queue commandBuffer];
    id<MTLComputeCommandEncoder> enc = [cmd computeCommandEncoder];
    [enc setComputePipelineState:pipeline];
    for (NSUInteger i = 0; i < [buffers count]; i++)
        [enc setBuffer:buffers[i] offset:0 atIndex:i];
    MTLSize grid = MTLSizeMake(N, 1, 1);
    MTLSize tg = MTLSizeMake(std::min(N, 256u), 1, 1);
    [enc dispatchThreads:grid threadsPerThreadgroup:tg];
    [enc endEncoding];
    [cmd commit];
    [cmd waitUntilCompleted];
}

id<MTLBuffer> matvec(id<MTLDevice> device, id<MTLCommandQueue> queue,
                     id<MTLComputePipelineState> pipeline,
                     id<MTLBuffer> weight, id<MTLBuffer> input, int outDim, int inDim) {
    id<MTLBuffer> output = [device newBufferWithLength:outDim * sizeof(uint16_t) options:MTLResourceStorageModeShared];
    id<MTLCommandBuffer> cmd = [queue commandBuffer];
    id<MTLComputeCommandEncoder> enc = [cmd computeCommandEncoder];
    [enc setComputePipelineState:pipeline];
    [enc setBuffer:weight offset:0 atIndex:0];
    [enc setBuffer:input  offset:0 atIndex:1];
    [enc setBuffer:output offset:0 atIndex:2];
    uint K = inDim;
    [enc setBytes:&K length:sizeof(uint) atIndex:3];

    uint gsize = 128;
    size_t tg_bytes = (gsize / 32) * sizeof(float);
    [enc setThreadgroupMemoryLength:tg_bytes atIndex:0];

    MTLSize grid = MTLSizeMake(outDim, 1, 1);
    MTLSize group = MTLSizeMake(gsize, 1, 1);
    [enc dispatchThreadgroups:grid threadsPerThreadgroup:group];
    [enc endEncoding];
    [cmd commit];
    [cmd waitUntilCompleted];
    return output;
}

// CPU RoPE
void apply_rope(std::vector<float>& vec, int pos, int head_dim, float theta = 10000.0f) {
    for (int i = 0; i < head_dim; i += 2) {
        float freq = 1.0f / powf(theta, (float)i / head_dim);
        float cos_val = cosf((float)pos * freq);
        float sin_val = sinf((float)pos * freq);
        float a = vec[i];
        float b = vec[i + 1];
        vec[i] = a * cos_val - b * sin_val;
        vec[i + 1] = a * sin_val + b * cos_val;
    }
}

// CPU attention (one head)
std::vector<float> attention_head(const std::vector<float>& q,
                                  const std::vector<float>& k_all,
                                  const std::vector<float>& v_all,
                                  int num_tokens, int head_dim) {
    std::vector<float> scores(num_tokens);
    for (int t = 0; t < num_tokens; t++) {
        float dot = 0.0f;
        for (int d = 0; d < head_dim; d++) dot += q[d] * k_all[t * head_dim + d];
        scores[t] = dot / sqrtf((float)head_dim);
    }
    float max_score = *std::max_element(scores.begin(), scores.end());
    float sum_exp = 0.0f;
    for (int t = 0; t < num_tokens; t++) {
        scores[t] = expf(scores[t] - max_score);
        sum_exp += scores[t];
    }
    for (int t = 0; t < num_tokens; t++) scores[t] /= sum_exp;
    std::vector<float> out(head_dim, 0.0f);
    for (int t = 0; t < num_tokens; t++) {
        for (int d = 0; d < head_dim; d++) out[d] += scores[t] * v_all[t * head_dim + d];
    }
    return out;
}



// ── Main ────────────────────────────────────────────────

int main(int argc, char* argv[]) {
    id<MTLDevice> device = MTLCreateSystemDefaultDevice();
    id<MTLCommandQueue> queue = [device newCommandQueue];
    id<MTLLibrary> library = [device newDefaultLibrary];
    if (!library) { std::cerr << "default.metallib not found\n"; return 1; }
    if (metal_init() != 0) { std::cerr << "bridge init failed\n"; return 1; }

    // Pipelines
    auto loadPipe = [&](NSString* name) {
        return [device newComputePipelineStateWithFunction:[library newFunctionWithName:name] error:nil];
    };
    auto pipeRmsNorm = loadPipe(@"rms_norm");
    auto pipeResAdd  = loadPipe(@"residual_add");
    auto pipeMatvec  = loadPipe(@"matvec_float4");  // 👈 change to your matvec kernel name

    // Load weights
    auto loadW = [&](const std::string& fname) {
        return loadHalfBuffer(device, "qwen_weights/" + fname + ".bin");
    };
    id<MTLBuffer> embed = loadW("embed_tokens.weight");
    id<MTLBuffer> final_norm = loadW("norm.weight");
    id<MTLBuffer> lm_head = loadW("lm_head.weight");

    struct LayerWeights {
        id<MTLBuffer> input_norm, post_norm;
        id<MTLBuffer> q_proj, k_proj, v_proj, o_proj;
        id<MTLBuffer> gate, up, down;
    };
    std::vector<LayerWeights> layers;
    for (int i = 0; i < NUM_LAYERS; i++) {
        LayerWeights w;
        w.input_norm = loadW("layer" + std::to_string(i) + ".input_layernorm.weight");
        w.post_norm  = loadW("layer" + std::to_string(i) + ".post_attention_layernorm.weight");
        w.q_proj = loadW("layer" + std::to_string(i) + ".self_attn.q_proj.weight");
        w.k_proj = loadW("layer" + std::to_string(i) + ".self_attn.k_proj.weight");
        w.v_proj = loadW("layer" + std::to_string(i) + ".self_attn.v_proj.weight");
        w.o_proj = loadW("layer" + std::to_string(i) + ".self_attn.o_proj.weight");
        w.gate = loadW("layer" + std::to_string(i) + ".mlp.gate_proj.weight");
        w.up   = loadW("layer" + std::to_string(i) + ".mlp.up_proj.weight");
        w.down = loadW("layer" + std::to_string(i) + ".mlp.down_proj.weight");
        layers.push_back(w);
    }

    // Concatenate MLP weights into single buffers for batched kernel
    id<MTLBuffer> bigGate = [device newBufferWithLength:NUM_LAYERS * INTERMEDIATE * HIDDEN_DIM * sizeof(uint16_t) options:MTLResourceStorageModeShared];
    id<MTLBuffer> bigUp   = [device newBufferWithLength:NUM_LAYERS * INTERMEDIATE * HIDDEN_DIM * sizeof(uint16_t) options:MTLResourceStorageModeShared];
    id<MTLBuffer> bigDown = [device newBufferWithLength:NUM_LAYERS * HIDDEN_DIM * INTERMEDIATE * sizeof(uint16_t) options:MTLResourceStorageModeShared];
    for (int i = 0; i < NUM_LAYERS; i++) {
        memcpy((uint16_t*)[bigGate contents] + i * INTERMEDIATE * HIDDEN_DIM,
               [layers[i].gate contents], layers[i].gate.length);
        memcpy((uint16_t*)[bigUp   contents] + i * INTERMEDIATE * HIDDEN_DIM,
               [layers[i].up   contents], layers[i].up.length);
        memcpy((uint16_t*)[bigDown contents] + i * HIDDEN_DIM * INTERMEDIATE,
               [layers[i].down contents], layers[i].down.length);
    }

    // Pre-load MLP kernels to cache buffers
    float dummy_gate_out[NUM_LAYERS * INTERMEDIATE], dummy_up_out[NUM_LAYERS * INTERMEDIATE];
    float dummy_x[NUM_LAYERS * HIDDEN_DIM] = {0};
    run_gate_up_batched((const uint16_t*)[bigGate contents], (const uint16_t*)[bigUp contents],
                        dummy_x, dummy_gate_out, dummy_up_out, NUM_LAYERS, INTERMEDIATE, HIDDEN_DIM);
    float dummy_mlp[NUM_LAYERS * INTERMEDIATE] = {0};
    float dummy_down_out[NUM_LAYERS * HIDDEN_DIM];
    run_down_batched((const uint16_t*)[bigDown contents], dummy_mlp, dummy_down_out,
                     NUM_LAYERS, HIDDEN_DIM, INTERMEDIATE);

    // KV caches
    std::vector<std::vector<uint16_t>> k_cache(NUM_LAYERS), v_cache(NUM_LAYERS);

    // Input token IDs (from command line or default)
    std::vector<int> input_ids;
    if (argc > 1) {
        for (int i = 1; i < argc; i++) input_ids.push_back(std::stoi(argv[i]));
    } else {
        input_ids = {1053};   // fallback: token for "The"
    }

    int seq_len = 0;
    std::vector<int> generated_ids;
    const int max_new_tokens = 10;

    // ── Token generation loop ──────────────────────────
    for (int step = 0; step < input_ids.size() + max_new_tokens; step++) {
        int token_id = (step < input_ids.size()) ? input_ids[step] : generated_ids.back();

        // Embedding
        id<MTLBuffer> hidden = [device newBufferWithLength:HIDDEN_DIM * sizeof(uint16_t) options:MTLResourceStorageModeShared];
        {
            uint16_t* hptr = (uint16_t*)[hidden contents];
            uint16_t* eptr = (uint16_t*)[embed contents] + token_id * HIDDEN_DIM;
            memcpy(hptr, eptr, HIDDEN_DIM * sizeof(uint16_t));
        }

        int current_pos = seq_len++;

        for (int l = 0; l < NUM_LAYERS; l++) {
            // Pre‑attention RMSNorm
            id<MTLBuffer> normed = [device newBufferWithLength:HIDDEN_DIM * sizeof(uint16_t) options:MTLResourceStorageModeShared];
            uint d = HIDDEN_DIM;
            id<MTLBuffer> d_buf = [device newBufferWithBytes:&d length:sizeof(uint) options:MTLResourceStorageModeShared];
            runKernel(device, queue, pipeRmsNorm, @[hidden, layers[l].input_norm, normed, d_buf], HIDDEN_DIM);

            // Q, K, V projections
            id<MTLBuffer> q_buf = matvec(device, queue, pipeMatvec, layers[l].q_proj, normed, NUM_HEADS*HEAD_DIM, HIDDEN_DIM);
            id<MTLBuffer> k_buf = matvec(device, queue, pipeMatvec, layers[l].k_proj, normed, NUM_KV_HEADS*HEAD_DIM, HIDDEN_DIM);
            id<MTLBuffer> v_buf = matvec(device, queue, pipeMatvec, layers[l].v_proj, normed, NUM_KV_HEADS*HEAD_DIM, HIDDEN_DIM);

            // Convert to float
            auto toFloatVec = [](id<MTLBuffer> buf, int len) {
                std::vector<float> vec(len);
                uint16_t* ptr = (uint16_t*)[buf contents];
                for (int i = 0; i < len; i++) {
                    __fp16 h; memcpy(&h, &ptr[i], sizeof(h));
                    vec[i] = (float)h;
                }
                return vec;
            };
            std::vector<float> q_float = toFloatVec(q_buf, NUM_HEADS*HEAD_DIM);
            std::vector<float> k_float = toFloatVec(k_buf, NUM_KV_HEADS*HEAD_DIM);
            std::vector<float> v_float = toFloatVec(v_buf, NUM_KV_HEADS*HEAD_DIM);

            // RoPE
            for (int h = 0; h < NUM_HEADS; h++) {
                std::vector<float> q_head(q_float.begin() + h*HEAD_DIM, q_float.begin() + (h+1)*HEAD_DIM);
                apply_rope(q_head, current_pos, HEAD_DIM);
                std::copy(q_head.begin(), q_head.end(), q_float.begin() + h*HEAD_DIM);
            }
            for (int h = 0; h < NUM_KV_HEADS; h++) {
                std::vector<float> k_head(k_float.begin() + h*HEAD_DIM, k_float.begin() + (h+1)*HEAD_DIM);
                apply_rope(k_head, current_pos, HEAD_DIM);
                std::copy(k_head.begin(), k_head.end(), k_float.begin() + h*HEAD_DIM);
            }

            // Append to KV cache
            auto toHalfVec = [](const std::vector<float>& fvec) {
                std::vector<uint16_t> hvec(fvec.size());
                for (size_t i = 0; i < fvec.size(); i++) {
                    __fp16 h = (__fp16)fvec[i];
                    memcpy(&hvec[i], &h, sizeof(h));
                }
                return hvec;
            };
            k_cache[l].insert(k_cache[l].end(), toHalfVec(k_float).begin(), toHalfVec(k_float).end());
            v_cache[l].insert(v_cache[l].end(), toHalfVec(v_float).begin(), toHalfVec(v_float).end());

            // Attention (GQA)
            std::vector<float> attn_out_float(NUM_HEADS*HEAD_DIM, 0.0f);
            for (int h = 0; h < NUM_HEADS; h++) {
                int kv_head = h * NUM_KV_HEADS / NUM_HEADS;
                std::vector<float> q_head(q_float.begin() + h*HEAD_DIM, q_float.begin() + (h+1)*HEAD_DIM);
                int num_tokens = k_cache[l].size() / (NUM_KV_HEADS*HEAD_DIM);
                std::vector<float> k_all(num_tokens*HEAD_DIM), v_all(num_tokens*HEAD_DIM);
                for (int t = 0; t < num_tokens; t++) {
                    int off = t * NUM_KV_HEADS*HEAD_DIM + kv_head*HEAD_DIM;
                    for (int d = 0; d < HEAD_DIM; d++) {
                        __fp16 h; memcpy(&h, &k_cache[l][off+d], sizeof(h)); k_all[t*HEAD_DIM+d] = (float)h;
                        memcpy(&h, &v_cache[l][off+d], sizeof(h)); v_all[t*HEAD_DIM+d] = (float)h;
                    }
                }
                auto head_out = attention_head(q_head, k_all, v_all, num_tokens, HEAD_DIM);
                std::copy(head_out.begin(), head_out.end(), attn_out_float.begin() + h*HEAD_DIM);
            }

            // Convert attention output back to half buffer
            id<MTLBuffer> attn_out = [device newBufferWithLength:NUM_HEADS*HEAD_DIM*sizeof(uint16_t) options:MTLResourceStorageModeShared];
            {
                uint16_t* ptr = (uint16_t*)[attn_out contents];
                for (int i = 0; i < NUM_HEADS*HEAD_DIM; i++) {
                    __fp16 h = (__fp16)attn_out_float[i];
                    memcpy(&ptr[i], &h, sizeof(h));
                }
            }

            // Output projection
            id<MTLBuffer> attn_proj = matvec(device, queue, pipeMatvec, layers[l].o_proj, attn_out, HIDDEN_DIM, NUM_HEADS*HEAD_DIM);
            runKernel(device, queue, pipeResAdd, @[hidden, attn_proj], HIDDEN_DIM);

            // Post‑attention RMSNorm
            normed = [device newBufferWithLength:HIDDEN_DIM*sizeof(uint16_t) options:MTLResourceStorageModeShared];
            runKernel(device, queue, pipeRmsNorm, @[hidden, layers[l].post_norm, normed, d_buf], HIDDEN_DIM);

            // ── Your batched MLP ─────────────────────────
            float* x_batch = new float[NUM_LAYERS * HIDDEN_DIM];
            uint16_t* normPtr = (uint16_t*)[normed contents];
            for (int i = 0; i < NUM_LAYERS; i++)
                for (int j = 0; j < HIDDEN_DIM; j++) {
                    __fp16 h; memcpy(&h, &normPtr[j], sizeof(h));
                    x_batch[i*HIDDEN_DIM + j] = (float)h;
                }

            float* gate_out = new float[NUM_LAYERS*INTERMEDIATE];
            float* up_out   = new float[NUM_LAYERS*INTERMEDIATE];
            run_gate_up_batched((const uint16_t*)[bigGate contents], (const uint16_t*)[bigUp contents],
                                x_batch, gate_out, up_out, NUM_LAYERS, INTERMEDIATE, HIDDEN_DIM);

            float* mlp_hidden = new float[NUM_LAYERS*INTERMEDIATE];
            for (int i = 0; i < NUM_LAYERS*INTERMEDIATE; i++) {
                float g = gate_out[i];
                float silu = g / (1.0f + expf(-g));
                mlp_hidden[i] = silu * up_out[i];
            }

            float* down_out = new float[NUM_LAYERS*HIDDEN_DIM];
            run_down_batched((const uint16_t*)[bigDown contents], mlp_hidden, down_out,
                             NUM_LAYERS, HIDDEN_DIM, INTERMEDIATE);

            for (int j = 0; j < HIDDEN_DIM; j++) {
                __fp16 h = (__fp16)down_out[l*HIDDEN_DIM + j];
                memcpy(&normPtr[j], &h, sizeof(h));
            }

            runKernel(device, queue, pipeResAdd, @[hidden, normed], HIDDEN_DIM);

            delete[] x_batch; delete[] gate_out; delete[] up_out; delete[] mlp_hidden; delete[] down_out;
        }

        // Final RMSNorm + LM head
        id<MTLBuffer> final_hidden = [device newBufferWithLength:HIDDEN_DIM*sizeof(uint16_t) options:MTLResourceStorageModeShared];
        uint d = HIDDEN_DIM;
        id<MTLBuffer> d_buf = [device newBufferWithBytes:&d length:sizeof(uint) options:MTLResourceStorageModeShared];
        runKernel(device, queue, pipeRmsNorm, @[hidden, final_norm, final_hidden, d_buf], HIDDEN_DIM);

        id<MTLBuffer> logits_buf = matvec(device, queue, pipeMatvec, lm_head, final_hidden, VOCAB_SIZE, HIDDEN_DIM);
        uint16_t* logits = (uint16_t*)[logits_buf contents];
        float max_val = -INFINITY;
        int next_token = 0;
        for (int i = 0; i < VOCAB_SIZE; i++) {
            __fp16 h; memcpy(&h, &logits[i], sizeof(h));
            float val = (float)h;
            if (val > max_val) { max_val = val; next_token = i; }
        }

        if (step >= input_ids.size()) generated_ids.push_back(next_token);
        else generated_ids.push_back(token_id);

        std::cout << "Token " << step << ": " << next_token << " (score " << max_val << ")\n";
    }

    std::cout << "Generated IDs: ";
    for (int id : generated_ids) std::cout << id << " ";
    std::cout << std::endl;
    return 0;
}
